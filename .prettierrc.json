{
  "overrides": [
    {
      "files": ["*.html", "*.htm"],
      "options": {
        "parser": "html",
        "printWidth": 120,
        "tabWidth": 2,
        "useTabs": false,
        "singleQuote": false,
        "quoteProps": "as-needed",
        "trailingComma": "none",
        "bracketSpacing": true,
        "bracketSameLine": false,
        "htmlWhitespaceSensitivity": "ignore"
      }
    },
    {
      "files": ["templates/**/*.html"],
      "options": {
        "parser": "html",
        "printWidth": 120,
        "tabWidth": 2,
        "useTabs": false,
        "htmlWhitespaceSensitivity": "ignore",
        "singleAttributePerLine": false
      }
    }
  ],
  "ignore": [
    "*.py",
    "*.sqlite3",
    "*.db",
    ".venv/**",
    "venv/**",
    "node_modules/**",
    "**/__pycache__/**",
    "**/migrations/**",
    "static/**",
    "media/**"
  ]
}
